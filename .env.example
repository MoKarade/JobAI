# ─── Intégration hub ──────────────────────────────────────────────────────────
# Jeton partagé avec le hub. Le hub l'envoie dans le header x-hub-token ; sans lui,
# GET /api/hub/summary répond 503 (jamais de summary sans auth configurée).
# Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# La MÊME valeur doit être posée côté hub sous le nom HUB_TOKEN_JOBAI.
# À copier en .env.local (jamais committé) et dans les variables Vercel.
HUB_TOKEN=

# ─── Domicile de référence (calcul de distance) ───────────────────────────────
# L'adresse exacte ne doit JAMAIS être committée (garde-fou n°1 du CLAUDE.md) :
# seules ces coordonnées, posées en variables d'environnement, servent au calcul
# du rayon de 50 km.
DOMICILE_LAT=
DOMICILE_LON=

# ─── Auth utilisateur — à partir de [V1-04] ───────────────────────────────────
# Auth.js v5 + Google, une seule adresse autorisée.
# AUTH_SECRET : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Redirect URIs à déclarer dans la console Google Cloud (le projet du hub fait l'affaire) :
#   http://localhost:3000/api/auth/callback/google
#   https://emploi.hubperso.com/api/auth/callback/google
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_URL=https://emploi.hubperso.com
# AUTHORIZED_EMAIL=

# ─── Base de données — à partir de [V1-01] ────────────────────────────────────
# Neon (Postgres serverless), injectée par l'intégration Vercel.
# DATABASE_URL=
