{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "*/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/veille",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/geocodage",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/geocodage?passe=apres-midi",
      "schedule": "0 19 * * *"
    }
  ],
  "ignoreCommand": "bash scripts/build-necessaire.sh"
}
